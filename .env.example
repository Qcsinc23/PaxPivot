# Run make setup to generate local values in ignored .env; never paste production secrets here.
# Per-checkout Compose project name; keeps worktrees on separate volumes (ADR-002).
COMPOSE_PROJECT_NAME=
# Per-checkout loopback host ports for the Compose services.
POSTGRES_PORT=
REDIS_PORT=
# Local PostgreSQL password (generated by setup).
POSTGRES_PASSWORD=
# SQLAlchemy psycopg URL for local development only.
DATABASE_URL=
# Declared for a future worker; nothing imports redis or rq today and no jobs are scheduled.
REDIS_URL=
# Source retrieval (API process only; `make check-sources`, `make source-report` needs none).
# Without it check-sources retrieves nothing and exits 2. Never give it to the web server.
FIRECRAWL_API_KEY=
# --- Web server → PaxPivot API (server-only; never NEXT_PUBLIC_) — ADR-004/ADR-005
# Base URL of the API as seen from the web server, e.g. http://127.0.0.1:8000
PAXPIVOT_API_URL=
# Shared bearer token (>= 32 chars) set on BOTH the API and the web server.
PAXPIVOT_API_TOKEN=
# --- Human → web application (pilot sign-in) — ADR-005. Production fails closed without both.
# Signs the session cookie (>= 32 chars).
PAXPIVOT_SESSION_SECRET=
# What the single pilot user types at /login (>= 20 chars).
PAXPIVOT_PILOT_PASSPHRASE=
# --- Ops (TASK-045), production only. Optional owner-provided secret: a dead-man monitor ping
# URL (e.g. from healthchecks.io or Cronitor) that deploy/run-checks.sh pings after every
# successful check-sources run. Leave empty to disable the ping. Never given to the web server;
# read directly from .env.production by grep, not sourced. See docs/DEPLOYMENT.md ("Heartbeat").
PAXPIVOT_HEARTBEAT_URL=
