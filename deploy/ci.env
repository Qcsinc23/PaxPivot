# CI-ONLY dummy values for `docker compose config` validation of compose.prod.yml
# plus deploy/compose.traefik.yml (TASK-047). These are NOT secrets: they are never used
# to start a real service, only to satisfy the required `${VAR:?...}` interpolation so
# `make compose-check` can validate the prod topology in CI. Never put real credentials here.
PAXPIVOT_DOMAIN=ci-fake.example.invalid
PAXPIVOT_API_TOKEN=ci-fake-api-token
PAXPIVOT_SESSION_SECRET=ci-fake-session-secret
PAXPIVOT_PILOT_PASSPHRASE=ci-fake-pilot-passphrase
POSTGRES_PASSWORD=ci-fake-postgres-password
